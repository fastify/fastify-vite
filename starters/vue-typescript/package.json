{
  "name": "vue-typescript-starter",
  "private": true,
  "description": "TypeScript starter template for @fastify/vue",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts --dev",
    "start": "node dist/server.js",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc",
    "typecheck": "vue-tsc --noEmit -p src/client/tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/one-line-logger": "^2.0.2",
    "@fastify/vite": "^10.0.0",
    "@fastify/vue": "^2.0.1",
    "@unhead/vue": "^3.4.0",
    "fastify": "^5.12.1",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "postcss": "^8.5.23",
    "postcss-preset-env": "^11.5.1",
    "tailwindcss": "^4.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.2.6"
  }
}
